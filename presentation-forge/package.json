{
  "name": "presentation-forge",
  "version": "1.1.0",
  "description": "AI-powered Slidev presentation creation, validation, and refinement. v1.1.0 includes security fixes (URL injection prevention, resource limits) and static validation.",
  "author": "Brian Lopez",
  "license": "MIT",
  "private": true,
  "scripts": {
    "slidev": "slidev",
    "slidev:dev": "slidev --open",
    "slidev:build": "slidev build",
    "slidev:export": "slidev export",
    "validate": "node validators/slide-crawler.js",
    "validate:overflow": "node validators/overflow-check.js",
    "validate:a11y": "node validators/accessibility-check.js",
    "validate:static": "node validators/validate-static.js",
    "validate:count": "node validators/validate-slide-count.js",
    "test": "node --test tests/",
    "test:security": "node --test tests/security.test.js"
  },
  "dependencies": {
    "@slidev/cli": "^0.49.0",
    "@slidev/theme-default": "^0.25.0",
    "playwright": "^1.40.0",
    "js-yaml": "^4.1.0",
    "node-fetch": "^3.3.0"
  },
  "devDependencies": {
    "mermaid": "^10.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "slidev",
    "presentation",
    "claude-code",
    "skill",
    "ai-workflow",
    "security"
  ]
}
